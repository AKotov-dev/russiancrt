[NAME]
name=russiancrt

[VERSION]
version=2022

[RELEASE]
release=3.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=Secure certificates from the Russian Ministry of Digital Development
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Secure certificates from the Russian Ministry of Digital Development

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/russiancrt

[LICENSE]
license=GPLv2

[DEPS]
deps=

[META]
meta=0

[NOARCH]
noarch=1

[DEB]
deb=0

[FILES]
0=/usr/share/pki/ca-trust-source/anchors/russian_new_root_ca.crt
1=/usr/share/pki/ca-trust-source/anchors/Russian-Secured-Private-Root.crt
2=/usr/share/doc/russiancrt/

[AFTERINSTALL]
0=#!/bin/bash
1=
2=update-ca-trust extract >/dev/null 2>&1 || :

[AFTERREMOVE]
0=#!/bin/bash
1=
2=update-ca-trust extract >/dev/null 2>&1 || :

[URL32]
url32=https://github.com/AKotov-dev/russiancrt

[PROGRAMNAME]
programname=russiancrt

[DEVTOOL]
devtool=Shell

[TOOLVERSION]
toolversion=unknown

[INFO]
0=v2022-3
1=+ Только для зон ru, su, рф
2=+ RPM/DEB пакеты для Mageia/Fedora/Ubuntu/etc.
3=
4=**Примечаие:** Использован механизм `nameConstraint` — ограничение, которое позволяет указать для каких доменов применимы сертификаты этого дерева сертификатов.
5=
6=
7=Инструкция Сбера с прямыми ссылками на сертификаты
8=---
9=https://www.sberbank.ru/ru/certificates/linux
10=
11=Обновление вручную (Mageia)
12=---
13=su/password
14=mkdir -p /usr/share/pki/ca-trust-source/anchors
15=cd /usr/share/pki/ca-trust-source/anchors/
16=
17=Скачать корневой сертификат
18=---
19=wget https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
20=
21=Скачать выпускающий сертификат
22=---
23=wget https://gu-st.ru/content/lending/russian_trusted_sub_ca_pem.crt
24=
25=Апдейт хранилища сертификатов
26=---
27=update-ca-trust
28=
29=Проверка установки сертификатов
30=---
31=trust list | grep Russian
32=
33=Проверка даты окончания действия сертификатов
34=---
35=openssl x509 -enddate -noout -in ./russian_trusted_sub_ca_pem.crt
36=openssl x509 -enddate -noout -in ./russian_trusted_root_ca_pem.crt
37=
38=
39=Инструкция от Минцифры без прямых ссылок на сертификаты
40=---
41=# Скачать корневой и выпускающий сертификаты: https://www.gosuslugi.ru/crt
42=> mkdir /usr/share/pki/ca-trust-source/anchors
43=> cp russian_trusted_root_ca.crt /usr/share/pki/ca-trust-source/anchors
44=> cp russian_trusted_sub_ca.crt /usr/share/pki/ca-trust-source/anchors
45=
46=# Обновить хранилище сертификатов
47=> update-ca-trust
48=# Проверить установку
49=> trust list | grep Russian
50=label: Russian Trusted Sub CA
51=label: Russian Trusted Root CA
52=
53=# Очистить кеш
54=# Caches (Mozilla, Chrome, Opera, Chromium, Palemoon)
55=rm -rf ~/.cache/mozilla/* \
56=~/.cache/google-chrome/* \
57=~/.cache/opera/* \
58=~/.cache/chromium/* \
59=~/.cache/moonchild\ productions/*
60=
61=# Очистить Cookies
62=rm -f $(find ~/.mozilla/* -type f -name "cookies.sqlite") \
63=~/.config/google-chrome/Default/Cookies* \
64=~/.config/opera/Cookies* \
65=~/.config/chromium/Default/Cookies* \
66=$(find ~/.moonchild\ productions/pale\ moon/* -type f -name "cookies.sqlite")
67=
68=---
69=Проверка наличия сертификатов в системе: http://www.sberbank.ru/ru/certificates
