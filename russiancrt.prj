[NAME]
name=russiancrt

[VERSION]
version=2022

[RELEASE]
release=2.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=Сertificates of the Ministry of Digital Development of Russia
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Сertificates of the Ministry of Digital Development of Russia

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/russiancrt

[LICENSE]
license=GPLv2

[DEPS]
deps=rootcerts openssl

[META]
meta=0

[NOARCH]
noarch=1

[DEB]
deb=0

[FILES]
0=/usr/share/pki/ca-trust-source/anchors/russian_trusted_sub_ca_pem.crt
1=/usr/share/pki/ca-trust-source/anchors/russian_trusted_root_ca_pem.crt
2=/usr/share/doc/russiancrt/

[AFTERINSTALL]
0=#!/bin/bash
1=
2=update-ca-trust
3=trust list | grep Russian

[AFTERREMOVE]
0=#!/bin/bash
1=
2=update-ca-trust

[URL32]
url32=https://github.com/AKotov-dev/russiancrt

[PROGRAMNAME]
programname=russiancrt

[DEVTOOL]
devtool=Shell

[TOOLVERSION]
toolversion=unknown

[INFO]
0=Инструкция Сбера с прямыми ссылками на сертификаты
1=---
2=https://www.sberbank.ru/ru/certificates/linux
3=
4=Обновление вручную (Mageia)
5=---
6=su/password
7=mkdir -p /usr/share/pki/ca-trust-source/anchors
8=cd /usr/share/pki/ca-trust-source/anchors/
9=
10=Скачать корневой сертификат
11=---
12=wget https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
13=
14=Скачать выпускающий сертификат
15=---
16=wget https://gu-st.ru/content/lending/russian_trusted_sub_ca_pem.crt
17=
18=Апдейт хранилища сертификатов
19=---
20=update-ca-trust
21=
22=Проверка установки сертификатов
23=---
24=trust list | grep Russian
25=
26=Проверка даты окончания действия сертификатов
27=---
28=openssl x509 -enddate -noout -in ./russian_trusted_sub_ca_pem.crt
29=openssl x509 -enddate -noout -in ./russian_trusted_root_ca_pem.crt
30=
31=
32=Инструкция от Минцифры без прямых ссылок на сертификаты
33=---
34=# Скачать корневой и выпускающий сертификаты: https://www.gosuslugi.ru/crt
35=> mkdir /usr/share/pki/ca-trust-source/anchors
36=> cp russian_trusted_root_ca.crt /usr/share/pki/ca-trust-source/anchors
37=> cp russian_trusted_sub_ca.crt /usr/share/pki/ca-trust-source/anchors
38=
39=# Обновить хранилище сертификатов
40=> update-ca-trust
41=# Проверить установку
42=> trust list | grep Russian
43=label: Russian Trusted Sub CA
44=label: Russian Trusted Root CA
45=
46=# Очистить кеш
47=# Caches (Mozilla, Chrome, Opera, Chromium, Palemoon)
48=rm -rf ~/.cache/mozilla/* \
49=~/.cache/google-chrome/* \
50=~/.cache/opera/* \
51=~/.cache/chromium/* \
52=~/.cache/moonchild\ productions/*
53=
54=# Очистить Cookies
55=rm -f $(find ~/.mozilla/* -type f -name "cookies.sqlite") \
56=~/.config/google-chrome/Default/Cookies* \
57=~/.config/opera/Cookies* \
58=~/.config/chromium/Default/Cookies* \
59=$(find ~/.moonchild\ productions/pale\ moon/* -type f -name "cookies.sqlite")
60=
61=---
62=Проверка наличия сертификатов в системе: http://www.sberbank.ru/ru/certificates
