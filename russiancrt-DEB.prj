[NAME]
name=russiancrt

[VERSION]
version=2022

[RELEASE]
release=4.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=Secure certificates from the Russian Ministry of Digital Development
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Secure certificates from the Russian Ministry of Digital Development

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/russiancrt

[LICENSE]
license=GPLv2

[DEPS]
deps=

[META]
meta=0

[NOARCH]
noarch=1

[DEB]
deb=1

[FILES]
0=/usr/local/share/ca-certificates/russian_secured_private_root_ca.crt
1=/usr/local/share/ca-certificates/russian_constrained_intermediate_ca.crt
2=/usr/share/doc/russiancrt/

[AFTERINSTALL]
0=#!/bin/bash
1=
2=update-ca-certificates --fresh >/dev/null 2>&1 || true

[AFTERREMOVE]
0=#!/bin/bash
1=
2=update-ca-certificates --fresh >/dev/null 2>&1 || true

[URL32]
url32=https://github.com/AKotov-dev/russiancrt

[PROGRAMNAME]
programname=russiancrt

[DEVTOOL]
devtool=Shell

[TOOLVERSION]
toolversion=unknown

[INFO]
0=v2022-4
1=+ DNS:ru, DNS:su, DNS:xn--p1ai (RFC 5280, §4.2.1.11)
2=+ Name Constraints перенесены в промежуточный сертификат
3=+ RPM/DEB пакеты для Mageia/Fedora/Ubuntu/etc.
4=
5=**Note:** Сертификаты работают как из системного хранилища без дополнительной настройки браузера, так и при ручном импорте.
6=
7=v2022-3
8=+ Ограничение: только для зон ru, su, рф
9=+ RPM/DEB пакеты для Mageia/Fedora/Ubuntu/etc.
10=
11=**Примечание:** Использован механизм `nameConstraint` — ограничение, которое позволяет указать для каких доменов применимы сертификаты этого дерева сертификатов.
12=
13=
14=Инструкция Сбера с прямыми ссылками на сертификаты
15=---
16=https://www.sberbank.ru/ru/certificates/linux
17=
18=Обновление вручную (Mageia)
19=---
20=su/password
21=mkdir -p /usr/share/pki/ca-trust-source/anchors
22=cd /usr/share/pki/ca-trust-source/anchors/
23=
24=Скачать корневой сертификат
25=---
26=wget https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
27=
28=Скачать выпускающий сертификат
29=---
30=wget https://gu-st.ru/content/lending/russian_trusted_sub_ca_pem.crt
31=
32=Апдейт хранилища сертификатов
33=---
34=update-ca-trust
35=
36=Проверка установки сертификатов
37=---
38=trust list | grep Russian
39=
40=Проверка даты окончания действия сертификатов
41=---
42=openssl x509 -enddate -noout -in ./russian_trusted_sub_ca_pem.crt
43=openssl x509 -enddate -noout -in ./russian_trusted_root_ca_pem.crt
44=
45=
46=Инструкция от Минцифры без прямых ссылок на сертификаты
47=---
48=# Скачать корневой и выпускающий сертификаты: https://www.gosuslugi.ru/crt
49=> mkdir /usr/share/pki/ca-trust-source/anchors
50=> cp russian_trusted_root_ca.crt /usr/share/pki/ca-trust-source/anchors
51=> cp russian_trusted_sub_ca.crt /usr/share/pki/ca-trust-source/anchors
52=
53=# Обновить хранилище сертификатов
54=> update-ca-trust
55=# Проверить установку
56=> trust list | grep Russian
57=label: Russian Trusted Sub CA
58=label: Russian Trusted Root CA
59=
60=# Очистить кеш
61=# Caches (Mozilla, Chrome, Opera, Chromium, Palemoon)
62=rm -rf ~/.cache/mozilla/* \
63=~/.cache/google-chrome/* \
64=~/.cache/opera/* \
65=~/.cache/chromium/* \
66=~/.cache/moonchild\ productions/*
67=
68=# Очистить Cookies
69=rm -f $(find ~/.mozilla/* -type f -name "cookies.sqlite") \
70=~/.config/google-chrome/Default/Cookies* \
71=~/.config/opera/Cookies* \
72=~/.config/chromium/Default/Cookies* \
73=$(find ~/.moonchild\ productions/pale\ moon/* -type f -name "cookies.sqlite")
74=
75=---
76=Проверка наличия сертификатов в системе: http://www.sberbank.ru/ru/certificates
