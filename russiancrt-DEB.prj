[NAME]
name=russiancrt

[VERSION]
version=2022

[RELEASE]
release=5.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=Secure certificates from the Russian Ministry of Digital Development
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Secure certificates from the Russian Ministry of Digital Development

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/russiancrt

[LICENSE]
license=GPLv2

[DEPS]
deps=

[META]
meta=0

[NOARCH]
noarch=1

[DEB]
deb=1

[FILES]
0=/usr/local/share/ca-certificates/russian_secured_private_root_ca.crt
1=/usr/local/share/ca-certificates/russian_constrained_intermediate_ca.crt
2=/usr/share/doc/russiancrt/

[AFTERINSTALL]
0=#!/bin/bash
1=
2=update-ca-certificates --fresh >/dev/null 2>&1 || true

[AFTERREMOVE]
0=#!/bin/bash
1=
2=update-ca-certificates --fresh >/dev/null 2>&1 || true

[URL32]
url32=https://github.com/AKotov-dev/russiancrt

[PROGRAMNAME]
programname=russiancrt

[DEVTOOL]
devtool=Shell

[TOOLVERSION]
toolversion=unknown

[INFO]
0=v2022-5
1=+ Улучшена совместимость сертификатной цепочки
2=+ RPM/DEB пакеты для Mageia/Fedora/Ubuntu/etc.
3=
4=v2022-4
5=+ DNS:ru, DNS:su, DNS:xn--p1ai (RFC 5280, §4.2.1.11)
6=+ Name Constraints перенесены в промежуточный сертификат
7=+ RPM/DEB пакеты для Mageia/Fedora/Ubuntu/etc.
8=
9=**Note:** Сертификаты работают как из системного хранилища без дополнительной настройки браузера, так и при ручном импорте.
10=
11=v2022-3
12=+ Ограничение: только для зон ru, su, рф
13=+ RPM/DEB пакеты для Mageia/Fedora/Ubuntu/etc.
14=
15=**Примечание:** Использован механизм `nameConstraint` — ограничение, которое позволяет указать для каких доменов применимы сертификаты этого дерева сертификатов.
16=
17=
18=Инструкция Сбера с прямыми ссылками на сертификаты
19=---
20=https://www.sberbank.ru/ru/certificates/linux
21=
22=Обновление вручную (Mageia)
23=---
24=su/password
25=mkdir -p /usr/share/pki/ca-trust-source/anchors
26=cd /usr/share/pki/ca-trust-source/anchors/
27=
28=Скачать корневой сертификат
29=---
30=wget https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
31=
32=Скачать выпускающий сертификат
33=---
34=wget https://gu-st.ru/content/lending/russian_trusted_sub_ca_pem.crt
35=
36=Апдейт хранилища сертификатов
37=---
38=update-ca-trust
39=
40=Проверка установки сертификатов
41=---
42=trust list | grep Russian
43=
44=Проверка даты окончания действия сертификатов
45=---
46=openssl x509 -enddate -noout -in ./russian_trusted_sub_ca_pem.crt
47=openssl x509 -enddate -noout -in ./russian_trusted_root_ca_pem.crt
48=
49=
50=Инструкция от Минцифры без прямых ссылок на сертификаты
51=---
52=# Скачать корневой и выпускающий сертификаты: https://www.gosuslugi.ru/crt
53=> mkdir /usr/share/pki/ca-trust-source/anchors
54=> cp russian_trusted_root_ca.crt /usr/share/pki/ca-trust-source/anchors
55=> cp russian_trusted_sub_ca.crt /usr/share/pki/ca-trust-source/anchors
56=
57=# Обновить хранилище сертификатов
58=> update-ca-trust
59=# Проверить установку
60=> trust list | grep Russian
61=label: Russian Trusted Sub CA
62=label: Russian Trusted Root CA
63=
64=# Очистить кеш
65=# Caches (Mozilla, Chrome, Opera, Chromium, Palemoon)
66=rm -rf ~/.cache/mozilla/* \
67=~/.cache/google-chrome/* \
68=~/.cache/opera/* \
69=~/.cache/chromium/* \
70=~/.cache/moonchild\ productions/*
71=
72=# Очистить Cookies
73=rm -f $(find ~/.mozilla/* -type f -name "cookies.sqlite") \
74=~/.config/google-chrome/Default/Cookies* \
75=~/.config/opera/Cookies* \
76=~/.config/chromium/Default/Cookies* \
77=$(find ~/.moonchild\ productions/pale\ moon/* -type f -name "cookies.sqlite")
78=
79=---
80=Проверка наличия сертификатов в системе: http://www.sberbank.ru/ru/certificates
